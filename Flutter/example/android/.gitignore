# gradle-wrapper.jar, gradlew, and gradlew.bat are kept in the
# repository so CI runners can invoke `./gradlew` without first
# installing a system Gradle (the `flutter create` default ignores
# them, but Flutter's own templates moved towards committing them).
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
